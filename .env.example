# Upstream API the server-side client talks to (src/lib/api/instances.ts)
API_BASE_URL="https://jsonplaceholder.typicode.com"

# Optional bearer token for the upstream API. Server-only — never NEXT_PUBLIC_.
# API_TOKEN=""

# Public origin, used for absolute internal fetches during SSR.
# On Vercel this may be left unset: a deployment falls back to its own
# VERCEL_URL, which is the only correct origin for a preview (its host is
# minted per deployment). Set it explicitly for production so the app pins
# itself to the stable alias instead of a deployment hash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
